#33=IFCDIRECTION((0.,0.,1.));
#34=IFCEXTRUDEDAREASOLID(#32,#11,#33,2.7);
#35=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#34));
#36=IFCPRODUCTDEFINITIONSHAPE($,$,(#35));
#37=IFCLOCALPLACEMENT(#25,#11);
#38=IFCWALL('1aWall0000000000000001',$,'Existing wall',$,$,#37,#36,'EW1',.SOLIDWALL.);
#39=IFCPROPERTYENUMERATEDVALUE('Status',$,(IFCLABEL('EXISTING')),$);
#40=IFCPROPERTYSET('1aPset0000000000000001',$,'Pset_WallCommon',$,(#39));
#41=IFCRELDEFINESBYPROPERTIES('1aRelPset0000000000001',$,$,$,(#38),#40);
#42=IFCMATERIAL('\X2\03A303BA03C503C103CC03B403B503BC03B1\X0\',$,'concrete');
#43=IFCRELASSOCIATESMATERIAL('1aRelMat00000000000001',$,$,$,(#38),#42);
/* A window: the opening is a plan rectangle extruded upwards from the sill. */
#50=IFCCARTESIANPOINT((2.,0.1,1.));
#51=IFCAXIS2PLACEMENT3D(#50,$,$);
#52=IFCLOCALPLACEMENT(#37,#51);
#53=IFCCARTESIANPOINT((0.,0.));
#54=IFCAXIS2PLACEMENT2D(#53,$);
#55=IFCRECTANGLEPROFILEDEF(.AREA.,$,#54,1.2,0.4);
#56=IFCEXTRUDEDAREASOLID(#55,#11,#33,1.2);
#57=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#56));
#58=IFCPRODUCTDEFINITIONSHAPE($,$,(#57));
#59=IFCOPENINGELEMENT('1aOpening0000000000001',$,'Opening',$,$,#52,#58,$,.OPENING.);
#60=IFCRELVOIDSELEMENT('1aRelVoids000000000001',$,$,$,#38,#59);
#61=IFCLOCALPLACEMENT(#52,#11);
#62=IFCWINDOW('1aWindow00000000000001',$,'Window',$,$,#61,$,'WN1',1.2,1.2,.WINDOW.,.SINGLE_PANEL.,$);
#63=IFCRELFILLSELEMENT('1aRelFills000000000001',$,$,$,#59,#62);
/* A column whose body is a mapped representation, offset 1 m in X and Y from its placement at (5, 5). */
#70=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,0.3,0.3);
#71=IFCEXTRUDEDAREASOLID(#70,#11,#33,3.);
#72=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#71));
#73=IFCREPRESENTATIONMAP(#11,#72);
#74=IFCCARTESIANPOINT((1.,1.,0.));
#75=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#74,1.,$);
