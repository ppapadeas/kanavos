#78=IFCPRODUCTDEFINITIONSHAPE($,$,(#77));
#79=IFCCARTESIANPOINT((5.,5.,0.));
#80=IFCAXIS2PLACEMENT3D(#79,$,$);
#81=IFCLOCALPLACEMENT(#25,#80);
#82=IFCCOLUMN('1aColumn00000000000001',$,'Column',$,$,#81,#78,$,.COLUMN.);
/* An L-shaped floor slab whose outline is a composite curve of two polylines, extruded downwards. */
#90=IFCCARTESIANPOINT((0.,0.));
#91=IFCCARTESIANPOINT((8.,0.));
#92=IFCCARTESIANPOINT((8.,3.));
#93=IFCCARTESIANPOINT((3.,3.));
#94=IFCCARTESIANPOINT((3.,6.));
#95=IFCCARTESIANPOINT((0.,6.));
#96=IFCPOLYLINE((#90,#91,#92,#93));
#97=IFCPOLYLINE((#93,#94,#95,#90));
#98=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#96);
#99=IFCCOMPOSITECURVESEGMENT(.CONTINUOUS.,.T.,#97);
#100=IFCCOMPOSITECURVE((#98,#99),.F.);
#101=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#100);
#102=IFCDIRECTION((0.,0.,-1.));
#103=IFCEXTRUDEDAREASOLID(#101,#11,#102,0.25);
#104=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#103));
#105=IFCPRODUCTDEFINITIONSHAPE($,$,(#104));
#106=IFCLOCALPLACEMENT(#25,#11);
#107=IFCSLAB('1aSlab0000000000000001',$,'Floor',$,$,#106,#105,$,.FLOOR.);
/* A roof made of one roof slab (the roof itself has no body), and a stair without geometry. */
#110=IFCLOCALPLACEMENT(#25,#11);
#111=IFCROOF('1aRoof0000000000000001',$,'Roof',$,$,#110,$,$,.FLAT_ROOF.);
#112=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,8.,6.);
#113=IFCCARTESIANPOINT((4.,3.,2.7));
#114=IFCAXIS2PLACEMENT3D(#113,$,$);
#115=IFCEXTRUDEDAREASOLID(#112,#114,#33,0.3);
#116=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#115));
#117=IFCPRODUCTDEFINITIONSHAPE($,$,(#116));
#118=IFCLOCALPLACEMENT(#110,#11);
#119=IFCSLAB('1aRoofSlab000000000001',$,'Roof slab',$,$,#118,#117,$,.ROOF.);
#120=IFCRELAGGREGATES('1aAggr0000000000000004',$,$,$,#111,(#119));
#121=IFCLOCALPLACEMENT(#25,#11);
#122=IFCSTAIR('1aStair000000000000001',$,'Stair',$,$,#121,$,$,.STRAIGHT_RUN_STAIR.);
#130=IFCRELCONTAINEDINSPATIALSTRUCTURE('1aRelCont0000000000001',$,$,$,(#38,#62,#82,#107,#111,#122),#26);
/* Georeferencing: the project X axis points to grid north. */
#140=IFCPROJECTEDCRS('EPSG:2100','GGRS87 / Greek Grid','GGRS87',$,$,$,$);
#141=IFCMAPCONVERSION(#12,#140,431000.,4100000.,10.,0.,1.,$);
/* A 1 x 1 m shaft cut through the floor slab by an opening element. */
#150=IFCCARTESIANPOINT((1.5,1.5,-0.5));
#151=IFCAXIS2PLACEMENT3D(#150,$,$);
#152=IFCLOCALPLACEMENT(#106,#151);
#153=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,1.,1.);
#154=IFCEXTRUDEDAREASOLID(#153,#11,#33,1.);
#155=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#154));
#156=IFCPRODUCTDEFINITIONSHAPE($,$,(#155));
#157=IFCOPENINGELEMENT('1aShaft000000000000001',$,'Shaft',$,$,#152,#156,$,.OPENING.);
#158=IFCRELVOIDSELEMENT('1aRelVoids000000000002',$,$,$,#107,#157);
ENDSEC;
END-ISO-10303-21;
