#28=IFCRELAGGREGATES('1aAggr0000000000000002',$,$,$,#22,(#24));
#29=IFCRELAGGREGATES('1aAggr0000000000000003',$,$,$,#24,(#26));
/* An existing wall without an axis representation: a 4 x 0.2 m band from an indexed poly curve. */
#30=IFCCARTESIANPOINTLIST2D(((0.,0.),(4.,0.),(4.,0.2),(0.,0.2)));
#31=IFCINDEXEDPOLYCURVE(#30,(IFCLINEINDEX((1,2,3,4,1))),.F.);
